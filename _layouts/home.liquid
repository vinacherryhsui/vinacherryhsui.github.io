---
layout: default
---
<div class="home">
    <style scoped>
        {% assign image = site.header_feature_image | relative_url | split: '.' %}
        .call-out_img {
            background-image: url('{{ image | join: '.' }}');
        }
        {% if site.header_feature_image_responsive %}
        @media screen and (max-width: 768px) {
            .call-out_img {
                background-image: url('{{ image[0] | append: '-medium.' | append: image[1] | default: image}}');
            }
        }
        @media screen and (max-width: 576px) {
            .call-out_img {
                background-image: url('{{ image[0] | append: '-small.' | append: image[1] }}');
            }
        }
        {% endif %}
    </style>
    <div id="main" class="call-out call-out_img">
        <h1> {{ site.header_text | default: "Change <code>header_text</code> in <code>_config.yml</code>"}} </h1>
    </div>
    <section class="home-intro">
        <p>用計量方法研究總體環境與台灣股市，也喜歡把研究裡的想法做成可以直接使用的產品或工具。</p>
        <p>國立政治大學（NCCU）國際經營與貿易學系碩士畢業，國立成功大學經濟系學士畢業。</p>
    </section>
    <section class="home-projects">
        <h2 id="projects">Projects</h2>
        {% capture project_list %}{% include project_list.html %}{% endcapture %}
        {% assign project_urls = project_list | split: '|' %}
        <div class="project-card-grid">
            {% for project_url in project_urls %}
                {% assign project = site.portfolio | where: "url", project_url | first %}
                {% include project_card.html project=project %}
            {% endfor %}
        </div>
    </section>
</div>
